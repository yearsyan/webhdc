{
  "name": "@webhdc/core",
  "version": "0.1.1",
  "description": "A dependency-free HDC client for HarmonyOS devices over WebUSB",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "hdc",
    "harmonyos",
    "openharmony",
    "webusb"
  ],
  "license": "Apache-2.0",
  "author": "yearsyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yearsyan/webhdc.git",
    "directory": "packages/webhdc"
  },
  "bugs": {
    "url": "https://github.com/yearsyan/webhdc/issues"
  },
  "homepage": "https://github.com/yearsyan/webhdc/tree/main/packages/webhdc",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && tsc -p tsconfig.types.json && tsx --test",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
